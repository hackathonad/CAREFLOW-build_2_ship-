# CareFlow AI - Backend Environment Configuration

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration (gemini | groq)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# Google Gemini API (Backend Only - NEVER expose to frontend or git)
GEMINI_API_KEY=

# Groq API (Backend Only - Fallback provider)
GROQ_API_KEY=

# Supabase PostgreSQL Configuration (Backend Only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Government Open Data API (data.gov.in)
GOV_DATA_API_KEY=
